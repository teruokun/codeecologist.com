---
import { getHomeCopy } from '../lib/copy';

const { services } = await getHomeCopy();
---

<section class="section" id="services" aria-labelledby="services-heading">
  <h2 id="services-heading">{services.heading}</h2>
  <p class="sub">{services.subtitle}</p>
  <ul class="two">
    {
      services.items.map((item) => (
        <li class="card">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </li>
      ))
    }
  </ul>
  <h3 class="subhead" id="engagements-heading">{services.engagements.heading}</h3>
  {services.engagements.subtitle && <p class="sub">{services.engagements.subtitle}</p>}
  <ul class="engagements" aria-labelledby="engagements-heading">
    {
      services.engagements.items.map((item) => (
        <li class="card">
          <h4>{item.title}</h4>
          {item.body && <p>{item.body}</p>}
        </li>
      ))
    }
  </ul>
</section>
