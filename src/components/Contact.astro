---
import { getHomeCopy, isFilled } from '../lib/copy';

// There is deliberately no contact form: a form needs a server endpoint, a
// mail-sending credential and a third-party spam check. Booking, email and
// LinkedIn are plain links, so this section loads no scripts and has no
// endpoint to abuse.
const { contact, links } = await getHomeCopy();

// A channel's link appears only once its real address is filled in. Until
// then its placeholder text shows instead (drafts only: `npm run check`
// blocks a production build that still has placeholders).
const direct = [
  { label: links.email, href: `mailto:${links.email}`, value: links.email },
  { label: 'LinkedIn', href: links.linkedin_url, value: links.linkedin_url },
];
---

<section class="section" id="contact" aria-labelledby="contact-heading">
  <h2 id="contact-heading">{contact.heading}</h2>
  <p class="sub">
    {contact.subtitle}
    {isFilled(contact.response_time) && <span> {contact.response_time}</span>}
  </p>
  <div class="contact">
    <div class="contact-card">
      <p>{contact.booking_title}</p>
      {
        isFilled(contact.booking_url) ? (
          <a class="btn" href={contact.booking_url} rel="noopener">
            {contact.booking_cta}
          </a>
        ) : (
          <p>{contact.booking_url}</p>
        )
      }
    </div>
    <div class="contact-card">
      <p>{contact.direct_title}</p>
      <ul class="direct-links">
        {
          direct.map((channel) => (
            <li>
              {isFilled(channel.value) ? (
                <a href={channel.href} rel="me">
                  {channel.label}
                </a>
              ) : (
                channel.value
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
