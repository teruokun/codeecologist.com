---
import { getHomeCopy, isFilled } from '../lib/copy';
import { getFeedItems } from '../lib/published';

const { footer, links: addresses } = await getHomeCopy();
const year = new Date().getFullYear();
const hasFeed = (await getFeedItems()).length > 0;

const owner = [footer.owner, isFilled(footer.business_name) ? footer.business_name : null, footer.location]
  .filter(Boolean)
  .join(' · ');

// Links appear only once their real address has been filled in, and the RSS
// link only once the feed has items.
const links = [
  { label: addresses.email, href: `mailto:${addresses.email}`, show: isFilled(addresses.email) },
  { label: 'GitHub', href: addresses.github_url, show: isFilled(addresses.github_url) },
  { label: 'BuildWarden', href: addresses.buildwarden_url, show: isFilled(addresses.buildwarden_url) },
  { label: 'LinkedIn', href: addresses.linkedin_url, show: isFilled(addresses.linkedin_url) },
  { label: 'RSS', href: '/rss.xml', show: hasFeed },
  { label: 'Supply chain', href: '/supply-chain', show: true },
].filter((link) => link.show);
---

<footer class="site-footer">
  <p>© {year} {owner}</p>
  {
    links.length > 0 && (
      <ul class="footer-links">
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    )
  }
</footer>
