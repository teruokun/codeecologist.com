---
import Base from '../../layouts/Base.astro';
import NewsList from '../../components/NewsList.astro';
import { getHomeCopy } from '../../lib/copy';
import { getPublished } from '../../lib/published';

const copy = (await getHomeCopy()).news;
const entries = await getPublished('news');
const empty = entries.length === 0;
---

<!-- While empty, this page is not linked from anywhere and is kept out of search indexes. -->
<Base title="News" noindex={empty}>
  <div class="page">
    <h1>{empty ? 'News' : copy.heading}</h1>
    {empty ? <p>Nothing here yet.</p> : <NewsList news={entries} />}
  </div>
</Base>
