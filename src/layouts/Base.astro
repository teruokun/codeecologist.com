---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { allowPlaceholders, getHomeCopy } from '../lib/copy';
import { getFeedItems } from '../lib/published';

interface Props {
  /** Page title. The site name is appended unless this is the homepage. */
  title?: string;
  description?: string;
  /** Keep the page out of search indexes. */
  noindex?: boolean;
}

const copy = await getHomeCopy();
const { title, description = copy.meta_description, noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${copy.site_name}` : copy.site_name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const hasFeed = (await getFeedItems()).length > 0;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {
      hasFeed && (
        <link rel="alternate" type="application/rss+xml" title={copy.site_name} href="/rss.xml" />
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={copy.site_name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <script is:inline src="/js/theme.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {
      allowPlaceholders && (
        <aside class="draft-banner" aria-label="Draft notice">
          Draft site: the text on this page is placeholder copy.
        </aside>
      )
    }
    <div class="wrap">
      <Nav />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
